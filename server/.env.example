# Monad testnet by default — see monskills addresses/gas skills for canonical values.
RPC_HTTP_URL=https://testnet-rpc.monad.xyz
RPC_WS_URL=wss://testnet-rpc.monad.xyz
CHAIN_ID=10143

CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Operator key: only used for admin round-lifecycle calls (createRound/startRound/
# cancelRound/revealBoard) — it never touches player funds, since payouts are pulled by
# each player's own wallet via revealSafeTile. Still: for anything beyond a hackathon demo,
# swap this for an Alchemy Agent Wallet session (monskills `wallet` skill) instead of a raw
# private key sitting in an env var.
OPERATOR_PRIVATE_KEY=0x...

PORT=8787
FREEZE_MS=5000

# Gates the operator-only round routes. Generate with: openssl rand -base64 24
ADMIN_TOKEN=change-me

# Lobby mode: keep one Open round available and auto-start it once enough players enter.
# Required for a public deployment — startRound is owner-only and has no UI.
AUTO_ROUND=false
AUTO_ROUND_WIDTH=4
AUTO_ROUND_HEIGHT=4
AUTO_ROUND_MINES=10
AUTO_ROUND_ENTRY_FEE_WEI=10000000000000000
AUTO_ROUND_MIN_PLAYERS=2
